# Build artifacts
# Root-level binary only (go build -o gitee ./cmd/gitee); cmd/gitee/ is source
# and must stay tracked — a bare "gitee" pattern would silently ignore it.
/gitee
/gitee.exe
/gitee-*
dist/
bin/
.cache/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test
coverage.txt
coverage.out
coverage.html
*.coverprofile

# CI / CD
.gitee-ci/

# Git credentials (NEVER commit — would leak tokens to public remote)
.git-credentials
.netrc

# Claude Code (AGENTS.md is intentionally tracked as public "AI Ready" docs)
agent.md
claude.md
CLAUDE.md

# Guide docs & local working notes (local only)
issue-fix-guide*.md
release-guide*.md
如何编写一份给minimax的可靠开发引导.md
common-todos.md
conversation-*.md
todo-*.md
xiaohongshu-*.md
gh-command-list.md
v*-修复指引.md
需要补充的内容指引.md

# Local audit / design scratch (not part of the released artifacts)
notes/
outputs/

# MCP / editor artifacts
.playwright-mcp/
**/.obsidian/

# Claude Code project files
.claude/

# Temp files
*.tmp

# Code signing (local only)
*.pem
*.key
*.crt

# Test reports & temp files (generated per-run, do not commit)
test/full-test-output.txt
test/API-ALIGNMENT-REPORT.md
test/FULL-TEST-REPORT.md
test/*.tmp

# Release binaries (prevent stray commits at repo root)
.psacowork/
migrate-runtime.*
